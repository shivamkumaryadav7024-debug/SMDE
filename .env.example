# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://maritime:maritime_pass@localhost:5432/maritime_docs

# LLM — swap provider/model without code changes
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here

# File handling
MAX_FILE_SIZE_MB=10
TEMP_UPLOAD_DIR=/tmp/maritime-uploads

# Queue (pg-boss uses DATABASE_URL, no extra infra needed)
JOB_CONCURRENCY=3

# Rate limiting
RATE_LIMIT_EXTRACT_RPM=20
RATE_LIMIT_GENERAL_RPM=60
